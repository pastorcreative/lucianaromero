---
import '../styles/global.css';
import '../cookiebanner/styles.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    noindex?: boolean;
}

const {
    title = 'LU.ROMERO',
    description = 'Luciana Romero — Makeup Artist & Hair Stylist. Portfolio de maquillaje editorial, comercial y nupcial en Barcelona.',
    ogImage = '/og-default.jpg',
    noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageAbsolute = new URL(ogImage, Astro.site).toString();
---
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}
        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageAbsolute} />
        <meta property="og:locale" content="es_ES" />
        <meta property="og:site_name" content="LU.ROMERO" />
        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageAbsolute} />
        <!-- Organization JSON-LD -->
        <script type="application/ld+json" is:inline set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Person",
            "name": "Luciana Romero",
            "jobTitle": "Makeup Artist & Hair Stylist",
            "url": "https://lucianaromero.com",
            "image": ogImageAbsolute,
            "sameAs": [
                "https://www.instagram.com/lu.romero_mua"
            ],
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Barcelona",
                "addressCountry": "ES"
            }
        })} />
        <slot name="head" />
        <!-- Prevent FOUC: apply dark class before first paint -->
        <script is:inline>
            (function() {
                const stored = localStorage.getItem('theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (stored === 'dark' || (!stored && prefersDark)) {
                    document.documentElement.classList.add('dark');
                }
            })();
        </script>
        <!-- Speculation Rules: prerender likely-next pages on hover (Chromium) -->
        <script type="speculationrules" is:inline>
        {
            "prerender": [{
                "where": { "href_matches": "/*" },
                "eagerness": "moderate"
            }]
        }
        </script>
    </head>
    <body class="m-0 bg-canvas font-sans transition-colors duration-300">
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
        <!-- Traduce los textos hardcodeados en inglés del banner de cookies -->
        <script is:inline>
            (function () {
                const MAP_LINKS = { 'Cookie Policy': 'Política de Cookies', 'Privacy Policy': 'Política de Privacidad' };
                const MAP_ROWS  = { 'Essential': 'Esencial', 'Always on': 'Siempre activo', 'Analytics': 'Analítica', 'Marketing': 'Marketing' };

                function translateRoot(root) {
                    // Links dentro de .cb-desc y .cb-modal-header
                    root.querySelectorAll('.cb-desc a, .cb-modal-header a').forEach(function (a) {
                        var t = a.textContent.trim();
                        if (MAP_LINKS[t]) a.textContent = MAP_LINKS[t];
                    });
                    // Text nodes "Read our … and …"
                    root.querySelectorAll('.cb-desc, .cb-modal-header p').forEach(function (el) {
                        el.childNodes.forEach(function (node) {
                            if (node.nodeType === 3) {
                                node.textContent = node.textContent
                                    .replace(/Read our/g, 'Lee nuestra')
                                    .replace(/ and\s*/g, ' y ');
                            }
                        });
                    });
                    // Panel de preferencias: spans y strongs
                    root.querySelectorAll('.cb-row span, .cb-row strong').forEach(function (el) {
                        var t = el.textContent.trim();
                        if (MAP_ROWS[t]) el.textContent = MAP_ROWS[t];
                    });
                }

                var observer = new MutationObserver(function () {
                    ['astro-consent-banner', 'astro-consent-modal'].forEach(function (id) {
                        var el = document.getElementById(id);
                        if (el && !el.dataset.translated) {
                            el.dataset.translated = '1';
                            translateRoot(el);
                        }
                    });
                });
                observer.observe(document.body, { childList: true, subtree: true });
            })();
        </script>
    </body>
</html>
