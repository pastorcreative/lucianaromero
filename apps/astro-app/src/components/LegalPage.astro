---
interface Section {
    heading: string;
    paragraphs: string[];
    items: string[];
}

interface Props {
    title: string;
    updatedAt: string;
    sections: Section[];
}

const { title, updatedAt, sections } = Astro.props;
---

<section class="relative z-10 bg-canvas py-16 md:py-24 transition-colors duration-300">
    <div class="container-site">

        <!-- Page header -->
        <div class="border-b-4 border-ink pb-6 mb-12 transition-colors duration-300">
            <h1 class="font-boldonse uppercase text-5xl md:text-6xl tracking-tight text-ink leading-tight">
                {title}
            </h1>
            <p class="font-aleo text-sm text-ink opacity-40 mt-3">
                Última actualización: {updatedAt}
            </p>
        </div>

        <!-- Sections -->
        <div class="flex flex-col gap-0 max-w-3xl">
            {sections.map((section, i) => (
                <div class="border-b-2 border-ink py-10 last:border-b-0">
                    <div class="flex gap-6 md:gap-10">
                        <!-- Section number -->
                        <div class="flex-shrink-0 w-8">
                            <span class="font-boldonse text-xs text-ink opacity-20 tabular-nums">
                                {String(i + 1).padStart(2, '0')}
                            </span>
                        </div>
                        <!-- Content -->
                        <div class="flex-1 flex flex-col gap-4">
                            <h2 class="font-boldonse uppercase text-lg md:text-xl tracking-tight text-ink leading-snug">
                                {section.heading}
                            </h2>
                            {section.paragraphs.map(p => (
                                <p class="font-aleo text-base text-ink opacity-75 leading-relaxed">
                                    {p}
                                </p>
                            ))}
                            {section.items.length > 0 && (
                                <ul class="flex flex-col gap-2 mt-1">
                                    {section.items.map(item => (
                                        <li class="flex items-start gap-3">
                                            <span class="font-boldonse text-ink opacity-40 flex-shrink-0 mt-1">—</span>
                                            <span class="font-aleo text-base text-ink opacity-75 leading-relaxed">{item}</span>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <!-- Back link -->
        <div class="mt-16 pt-8 border-t-2 border-ink">
            <a
                href="/"
                class="inline-flex items-center gap-2 font-boldonse uppercase text-xs tracking-[0.2em] text-ink opacity-50 hover:opacity-100 transition-opacity duration-150"
            >
                ← Volver al inicio
            </a>
        </div>

    </div>
</section>
