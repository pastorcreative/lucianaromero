---
import Layout from '../../layouts/Layout.astro';
import HeroPage from '../../components/HeroPage.astro';
import CourseIntro from '../../components/CourseIntro.astro';
import CourseLearning from '../../components/CourseLearning.astro';
import CourseDirector from '../../components/CourseDirector.astro';
import CourseAcademy from '../../components/CourseAcademy.astro';
import CourseCTA from '../../components/CourseCTA.astro';
import { fetchCursos, fetchCurso } from '../../lib/payload';

export async function getStaticPaths() {
    const cursos = await fetchCursos();
    return cursos.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const curso = await fetchCurso(slug!);

if (!curso) return Astro.redirect('/cursos', 302);

const breadcrumb = [
    { label: 'Inicio',        href: '/' },
    { label: 'Cursos',        href: '/cursos' },
    { label: curso.heroTitle, href: `/cursos/${slug}` },
];
---

<Layout
    title={curso.pageTitle}
    description={curso.intro?.lead ?? curso.heroSubtitle}
>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Course",
            "name": curso.heroTitle,
            "description": curso.intro?.lead || curso.heroSubtitle,
            "url": `https://lucianaromero.com/cursos/${slug}`,
            "provider": {
                "@type": "Organization",
                "name": curso.academy?.name || "LU.ROMERO Academy",
                "address": {
                    "@type": "PostalAddress",
                    "streetAddress": curso.academy?.address || "",
                    "addressLocality": "Barcelona",
                    "addressCountry": "ES"
                }
            },
            "educationalLevel": "Professional",
            "inLanguage": "es"
        })} />
    </Fragment>
    <HeroPage
        title={curso.heroTitle}
        subtitle={curso.heroSubtitle}
        breadcrumb={breadcrumb}
    />
    <CourseIntro intro={curso.intro} />
    <CourseLearning learning={curso.learning} />
    <CourseDirector director={curso.director} />
    <CourseAcademy academy={curso.academy} />
    <CourseCTA cta={curso.cta} />
</Layout>
