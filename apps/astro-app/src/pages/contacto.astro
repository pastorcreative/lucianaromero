---
import Layout from '../layouts/Layout.astro';
import HeroPage from '../components/HeroPage.astro';
import Contact from '../components/Contact.astro';

const breadcrumb = [
    { label: 'Inicio',   href: '/' },
    { label: 'Contacto', href: '/contacto' },
];
---

<Layout
    title="Contacto — LU.ROMERO"
    description="Contacta con Luciana Romero para proyectos de maquillaje editorial, comercial y nupcial en Barcelona y alrededores."
>
    <HeroPage
        title="CONTACTO"
        subtitle="— Hablemos de tu proyecto"
        breadcrumb={breadcrumb}
    />
    <Contact />
</Layout>
