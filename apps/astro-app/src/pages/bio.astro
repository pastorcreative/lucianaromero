---
import Layout from '../layouts/Layout.astro';
import HeroPage from '../components/HeroPage.astro';
import Bio from '../components/Bio.astro';
import { fetchBio } from '../lib/payload';

const bio = await fetchBio();

const breadcrumb = [
    { label: 'Inicio', href: '/' },
    { label: 'Bio',    href: '/bio' },
];
---

<Layout
    title={bio.seo.titulo || 'Bio — LU.ROMERO'}
    description={bio.seo.descripcion || 'Conoce a Luciana Romero, Makeup Artist & Hair Stylist con sede en Barcelona.'}
>
    <HeroPage
        title={bio.hero.titulo || 'BIO'}
        subtitle={bio.hero.subtitulo || '— Sobre Luciana Romero, MUA & Hair Artist'}
        breadcrumb={breadcrumb}
    />
    <Bio />
</Layout>
