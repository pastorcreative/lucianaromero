---
import Layout from '../layouts/Layout.astro';
import HeroPage from '../components/HeroPage.astro';
import Bio from '../components/Bio.astro';

const breadcrumb = [
    { label: 'Inicio', href: '/' },
    { label: 'Bio',    href: '/bio' },
];
---

<Layout
    title="Bio — LU.ROMERO"
    description="Conoce a Luciana Romero, Makeup Artist & Hair Stylist con sede en Barcelona. Especialista en maquillaje editorial, comercial y nupcial para moda y publicidad."
>
    <HeroPage
        title="BIO"
        subtitle="— Sobre Luciana Romero, MUA & Hair Artist"
        breadcrumb={breadcrumb}
    />
    <Bio />
</Layout>
